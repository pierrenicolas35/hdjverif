{
  "name": "hdjverif",
  "version": "2.0.0",
  "private": true,
  "description": "Moteur décisionnel de cotation HDJ (GHS) vs ACE — Instruction DGOS/R1/DSS/1A/2020/52 du 10 septembre 2020",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "import:referentiels": "node scripts/import-referentiels.mjs",
    "base:hdj": "node scripts/base-hdj.mjs",
    "sql:appliquer": "node scripts/appliquer-sql.mjs",
    "extraire:atih": "uv run --with pypdf python3 scripts/extraire-referentiel-atih.py",
    "import:referentiels:controle": "node scripts/import-referentiels.mjs --dry-run",
    "verifier:referentiel": "node scripts/verifier-referentiel.mjs",
    "maj:referentiels": "node scripts/maj-referentiels.mjs",
    "maj:referentiels:controle": "node scripts/maj-referentiels.mjs --verifier"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^2.1.4",
    "happy-dom": "^15.11.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
